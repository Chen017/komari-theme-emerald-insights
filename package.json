{
  "name": "komari-theme-emerald-insights",
  "type": "module",
  "version": "2.0.13",
  "packageManager": "bun@1.4.4",
  "author": {
    "name": "Chen017",
    "url": "https://github.com/Chen017"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chen017/komari-theme-emerald-insights.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:beta": "run-p type-check \"build-only --mode beta\"",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "publish": "bun scripts/publish.ts",
    "test": "node --import jiti/register --test \"tests/**/*.test.ts\"",
    "test:package": "node scripts/test-package.mjs",
    "verify": "bun run lint:check && bun run test && bun run build && bun run test:package",
    "lint:check": "eslint vite.config.ts scripts src/utils/rpc.ts tests/utils/rpc-cancellation.test.ts src/components/LoadChart.vue src/stores/app.ts src/features/cpu-steal tests/cpu-steal",
    "lint": "eslint . --fix --cache",
    "lint:eslint": "eslint . --fix --cache"
  },
  "dependencies": {
    "@iconify/vue": "^4.3.0",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "dayjs": "^1.11.19",
    "echarts": "^6.0.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.6.1",
    "tailwind-merge": "^3.4.0",
    "vue": "^3.5.28",
    "vue-echarts": "^8.0.1",
    "vue-router": "^5.0.2",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.4.3",
    "@tailwindcss/vite": "^4.1.16",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/tsconfig": "^0.8.1",
    "archiver": "^7.0.1",
    "eslint": "^9.39.2",
    "eslint-plugin-format": "^1.4.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "tailwindcss": "^4.1.16",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vue-tsc": "^3.2.4"
  },
  "overrides": {
    "tinypool": "2.1.2"
  }
}
